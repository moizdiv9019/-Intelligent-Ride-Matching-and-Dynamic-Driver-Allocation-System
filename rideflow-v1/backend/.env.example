APP_NAME=RideFlow API
APP_VERSION=1.0.0
APP_ENV=development
API_PREFIX=/api/v1

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rideflow

FRONTEND_ORIGINS=["http://localhost:5173"]

ROUTING_BASE_URL=https://your-routing-service.example
ROUTING_API_KEY=your-routing-api-key
ROUTING_TIMEOUT_SECONDS=10

OFFER_TIMEOUT_SECONDS=20
OFFER_EXPIRY_POLL_INTERVAL_SECONDS=5
DRIVER_LOCATION_MAX_AGE_SECONDS=30
DRIVER_SEARCH_RADIUS_METERS=5000

# Demo-only defaults; not final commercial pricing.
FARE_BASE_INR=30
FARE_PER_KM_INR=12
FARE_PER_MINUTE_INR=1
FARE_MINIMUM_INR=40
